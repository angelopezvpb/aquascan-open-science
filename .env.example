# AquaScan Environment Variables (example)
# Copy to .env and fill in real values

# IGME ArcGIS REST Service (public, needs no key)
# IGME_URL=https://services.arcgis.com/...

# Optional: custom data storage paths
# AQUASCAN_DATA_DIR=/path/to/data
# AQUASCAN_RAW_DIR=/path/to/data/raw

# Optional: logging level
# AQUASCAN_LOG_LEVEL=INFO