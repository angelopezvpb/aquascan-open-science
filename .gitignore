# .gitignore for AquaScan Open Science

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
venv/
ENV/
env/

# PyCharm
.idea/

# VS Code
.vscode/

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints/

# Mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Ruff
.ruff_cache/

# Pytest
.pytest_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover

# Environments
.env
.env.*
# Safe template — tracked on purpose
!.env.example

# Data files — do NOT store in Git
*.seg2
*.sg2
*.sgy
*.segy
*.parquet
*.npy
*.npz
*.h5
*.hdf5
*.fits

# CSV files — only allow small test fixtures explicitly
*.csv
*.tsv
# Curated aggregate reports (no record-level data) are intentionally tracked
!reports/*.csv

# JSON data dumps
*_dump.json
*_data.json

# Logs
*.log

# macOS
.DS_Store

# Tmp
tmp/
temp/
/tmp/
/temp/